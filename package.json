{
    "name": "panchang-platform",
    "version": "1.0.0",
    "private": true,
    "description": "Full-Stack Vedic Astrology Platform: Next.js Web, Expo Mobile, Shared ASTRO engine, Headless WordPress",
    "workspaces": [
        "apps/*",
        "packages/*",
        "services/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "type-check": "turbo run type-check",
        "test": "turbo run test",
        "clean": "turbo run clean",
        "ingest:run": "cd services/data-ingestion && npm run ingest",
        "ingest:cron": "cd services/data-ingestion && npm run cron"
    },
    "devDependencies": {
        "turbo": "^1.13.0",
        "typescript": "^5.4.5",
        "prettier": "^3.2.5"
    },
    "packageManager": "npm@10.5.0",
    "engines": {
        "node": ">=18.0.0"
    },
    "overrides": {
        "react": "18.2.0",
        "react-dom": "18.2.0"
    }
}